; KimiCodeGuard NSIS installer hooks (Tauri 2 installerHooks, SimpChinese / currentUser mode).
; Contract: guard-hook.exe is installed as a bundle resource at $INSTDIR\guard-hook.exe
; (tauri.conf.json: resources {"../../target/release/guard-hook.exe": "guard-hook.exe"}),
; so it sits next to guard-daemon.exe in the install dir.
;
; POSTINSTALL : 1) back up the current %USERPROFILE%\.kimi-code\config.toml to
;                  $INSTDIR\config.toml.kcg-preinstall (kept for byte-exact restore;
;                  never overwritten - oldest original wins, same semantics as
;                  guard-hook's config.toml.kcg-bak);
;               2) inject [[hooks]] via guard-hook.exe install (atomic write + readback
;                  verified inside guard-hook; dedupes marker blocks AND orphan blocks
;                  whose command references guard-hook.exe).
; PREUNINSTALL: if the preinstall backup exists, restore it byte-for-byte (this is what
;               makes "uninstall -> config hash identical to pre-install" hold even when
;               the machine already had a KimiCodeGuard injection, e.g. dev machines);
;               otherwise fall back to guard-hook.exe uninstall (removes only the marker
;               block - exact inverse for first-time users).
; Both run non-fatal: any failure is logged to %LOCALAPPDATA%\KimiCodeGuard\installer.log
; and the installer continues. A failed inject is detected later by the daemon self-protect
; patrol (tray turns red, "一键修复" re-injects). See docs/THREAT_MODEL.md.
;
; NOTE: KIMI_CODE_HOME override is not applied here - the installer targets the default
; config location. Users of KIMI_CODE_HOME should run the install subcommand manually.
;
; Trade-off (recorded in HANDOFF 坑 21): restoring the preinstall backup discards config
; edits the user made while KimiCodeGuard was installed. Byte-exact restore was deemed
; more important (M5 验收仪式要求卸载后哈希与装前一致).

!macro KCG_LOG_HOOK_RESULT action exitcode
  CreateDirectory "$LOCALAPPDATA\KimiCodeGuard"
  FileOpen $R9 "$LOCALAPPDATA\KimiCodeGuard\installer.log" a
  FileSeek $R9 0 END
  FileWrite $R9 "KimiCodeGuard NSIS ${action}: exit code ${exitcode}$\r$\n"
  FileClose $R9
!macroend

!macro NSIS_HOOK_POSTINSTALL
  DetailPrint "KimiCodeGuard: injecting hooks into $PROFILE\.kimi-code\config.toml"
  ; 装前备份（已存在则不覆盖，保留最初原版）
  IfFileExists "$PROFILE\.kimi-code\config.toml" 0 kcg_postinstall_inject
  IfFileExists "$INSTDIR\config.toml.kcg-preinstall" kcg_postinstall_inject
    CopyFiles "$PROFILE\.kimi-code\config.toml" "$INSTDIR\config.toml.kcg-preinstall"
    !insertmacro KCG_LOG_HOOK_RESULT "backup-preinstall" "0"
  kcg_postinstall_inject:
  nsExec::ExecToLog '"$INSTDIR\guard-hook.exe" install --config "$PROFILE\.kimi-code\config.toml" --daemon-path "$INSTDIR\guard-daemon.exe"'
  Pop $R0
  !insertmacro KCG_LOG_HOOK_RESULT "install" "$R0"
!macroend

!macro NSIS_HOOK_PREUNINSTALL
  DetailPrint "KimiCodeGuard: restoring $PROFILE\.kimi-code\config.toml"
  ; 有装前备份 → 逐字节还原（卸载后 config 与装前完全一致，含 dev 机现役注入指回原路径）
  IfFileExists "$INSTDIR\config.toml.kcg-preinstall" 0 kcg_preuninstall_fallback
    CopyFiles "$INSTDIR\config.toml.kcg-preinstall" "$PROFILE\.kimi-code\config.toml"
    Delete "$INSTDIR\config.toml.kcg-preinstall"
    !insertmacro KCG_LOG_HOOK_RESULT "uninstall-restore-backup" "0"
    Goto kcg_preuninstall_done
  kcg_preuninstall_fallback:
  ; 无备份（装前本就没有 config.toml）→ marker 块级移除
  nsExec::ExecToLog '"$INSTDIR\guard-hook.exe" uninstall --config "$PROFILE\.kimi-code\config.toml"'
  Pop $R0
  !insertmacro KCG_LOG_HOOK_RESULT "uninstall" "$R0"
  kcg_preuninstall_done:
!macroend
