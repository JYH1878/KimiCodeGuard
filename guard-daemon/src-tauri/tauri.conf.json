{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KimiCodeGuard",
  "version": "0.1.0",
  "identifier": "com.kimicodeguard.win",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "ask",
        "title": "KimiCodeGuard 安全确认",
        "width": 560,
        "height": 460,
        "url": "ask.html",
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "backgroundColor": "#1a1b26"
      }
    ]
  },
  "bundle": {
    "active": false,
    "publisher": "JYH1878",
    "copyright": "Copyright © 2026 JYH1878",
    "shortDescription": "Kimi Code 安全卫士托盘",
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
